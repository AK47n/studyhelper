{
  "name": "studyhelper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "过手总结台：把一节课整理成「量 — 公式 — 关系」的树，公式快速输入",
  "scripts": {
    "dev": "node server.js --dev",
    "build": "vite build",
    "start": "node server.js",
    "go": "vite build && node server.js",
    "sync": "node scripts/sync.js",
    "check": "node scripts/check-parse.js",
    "check:keys": "node scripts/check-keys.js",
    "check:scale": "node scripts/check-scale.js",
    "check:align": "node scripts/check-align.js",
    "check:highlight": "esbuild scripts/check-highlight.js --bundle --platform=node --format=cjs --outfile=.cache/check-highlight.cjs --external:katex --log-level=error && node .cache/check-highlight.cjs",
    "check:render": "esbuild scripts/check-render.js --bundle --platform=node --format=cjs --outfile=.cache/check-render.cjs --external:katex --log-level=error && node .cache/check-render.cjs",
    "check:rich": "node scripts/check-rich.js",
    "check:calc": "node scripts/check-calc.js",
    "check:chart": "node scripts/check-chart.js",
    "check:chart-layout": "node scripts/check-chart-layout.js",
    "check:chart-browser": "node scripts/check-chart-browser.js",
    "check:plot": "node scripts/check-plot.js",
    "check:plot-browser": "node scripts/check-plot-browser.js",
    "check:mount": "node scripts/bundle-mount.mjs && node .cache/check-mount-entry.mjs",
    "check:browser": "node scripts/cdp-open.js 9222 && timeout /t 5 >nul && node scripts\\cdp-align.js && node scripts\\cdp-caretfit.js",
    "check:board": "node scripts/check-board.js",
    "clean:dist": "node scripts/clean-dist.js",
    "check:shape": "node scripts/check-shape.js",
    "check:storage": "node scripts/check-storage.js",
    "check:delete": "node scripts/check-delete.js",
    "check:sidetree": "node scripts/check-sidetree.js",
    "check:ask": "node scripts/check-ask.js",
    "check:harness": "node scripts/check-harness.js",
    "check:export": "node scripts/check-export.js",
    "check:refit": "node scripts/check-refit.js",
    "check:default": "node scripts/check-default-mode.js",
    "check:board-browser": "node scripts/check-board-browser.js",
    "check:paper": "node scripts/check-paper.js",
    "check:lock": "node scripts/check-lock.js",
    "check:link": "node scripts/check-link.js",
    "check:pan": "node scripts/check-pan.js",
    "check:clip": "node scripts/check-clip.js",
    "check:frameperf": "node scripts/check-frameperf.js",
    "check:board-all": "npm run check:board && npm run check:board-browser",
    "check:browser-all": "npm run check:harness && npm run check:board-browser && npm run check:shape && npm run check:refit && npm run check:paper && npm run check:lock && npm run check:link && npm run check:pan && npm run check:clip && npm run check:shelf && npm run check:frameperf && npm run check:sidetree && npm run check:ask && npm run check:export && npm run check:highlighter && npm run check:ocr-browser && npm run check:deck && npm run check:followup-browser && npm run check:homework-browser && npm run check:docslice-browser && npm run check:default && npm run check:zoom && npm run check:loaded",
    "check:ocr": "node scripts/check-ocr-server.js",
    "check:ocr-browser": "node scripts/check-ocr-browser.js",
    "check:zoom": "node scripts/check-zoom.js",
    "check:highlighter": "node scripts/check-highlighter.js",
    "check:loaded": "node scripts/check-loaded.js",
    "check:gather": "node scripts/check-gather.js",
    "check:shelf": "node scripts/check-shelf.js",
    "regather": "node scripts/regather.js",
    "check:doc": "node scripts/check-doc.js",
    "check:doc-read": "node scripts/check-doc-read.js",
    "check:deck": "node scripts/check-deck.js",
    "check:docslice": "node scripts/check-docslice.js",
    "check:docslice-browser": "node scripts/check-docslice-browser.js",
    "check:doc-data": "node scripts/check-doc-data.js",
    "check:askfollow": "node scripts/check-askfollow.js",
    "check:keep": "node scripts/check-keep.js",
    "check:look": "node scripts/check-look.js",
    "check:look-browser": "node scripts/check-look-browser.js",
    "check:homework": "node scripts/check-homework.js",
    "check:followup-browser": "node scripts/check-followup-browser.js",
    "check:homework-browser": "node scripts/check-homework-browser.js",
    "check:srcvirt": "node scripts/check-srcvirt.js",
    "diag:board": "node scripts/diag-board.js",
    "diag:deckshift": "node scripts/diag-deck-shift.js",
    "diag:pan": "node scripts/diag-pan-frame.js",
    "diag:interact": "node scripts/diag-interact.js",
    "diag:net": "node scripts/diag-net.js",
    "perf:zoom": "node scripts/perf-cadence.js",
    "perf:fit": "node scripts/perf-fitloop.js",
    "perf:flash": "node scripts/perf-burst.js",
    "perf:cost": "node scripts/perf-recalc.js",
    "perf:who": "node scripts/perf-profile.js",
    "perf:switch": "node scripts/perf-switch.js",
    "try:ocr": "node scripts/try-ocr.js",
    "perf": "esbuild scripts/perf.js --bundle --platform=node --format=cjs --outfile=.cache/perf.cjs --external:katex --log-level=error && node .cache/perf.cjs",
    "check:all": "npm run check && npm run check:keys && npm run check:scale && npm run check:align && npm run check:highlight && npm run check:render && npm run check:rich && npm run check:mount && npm run check:board && npm run check:shape && npm run check:storage && npm run check:delete && npm run check:ocr && npm run check:homework && npm run check:keep && npm run check:docslice"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "katex": "^0.16.11",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "vite": "^7.0.0"
  }
}
